# Copy to .env and fill in as needed. All values are optional.

# --- Authenticated scanning (skills) ---
# Credentials used to log in before scanning protected pages.
# You can also pass these as command parameters instead of env vars.
PLAYWRIGHT_USER=
PLAYWRIGHT_PASSWORD=

# --- Persistent browser profile (MCP server) ---
# Reuse a logged-in Chromium profile across runs so you don't re-authenticate
# every session. Use a dedicated directory, not your default Chrome profile.
CHROME_USER_DATA_DIR=

# --- Optional MCP server tuning ---
# Force a visible (headed) browser window.
FORCE_HEADED_BROWSER=
# Directory for generated scan reports (defaults to the MCP server's reports/).
REPORTS_DIR=
NODE_ENV=development

# --- Jira integration (optional) ---
# Only needed if you use the skills' optional Jira features. Auth is via the
# Atlassian MCP server's OAuth browser flow; this only sets the site for URLs.
ATLASSIAN_SITE=your-domain.atlassian.net
